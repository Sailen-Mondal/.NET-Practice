# .gitattributes
# Normalize line endings: force LF in the repo, checkout as CRLF on Windows

* text=auto eol=lf

# Windows scripts — use CRLF on checkout
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# C# source files — LF in repo
*.cs    text eol=lf
*.csproj text eol=lf
*.slnx  text eol=lf
*.sln   text eol=lf

# Markdown / docs
*.md    text eol=lf

# Config files
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.xml   text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf

# Binaries — no conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.exe   binary
*.dll   binary
