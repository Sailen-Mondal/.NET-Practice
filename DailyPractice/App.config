<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Supported .NET Framework runtime specification -->
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <!-- Application database connection strings -->
    <connectionStrings>
        <!-- 
            DBConn: Main SQL Server database connection string
            Data Source: . (local SQL Server instance)
            Initial Catalog: BikeStores (target database)
            User ID: sa (SQL Server authentication username)
            Password: configured SQL credentials
        -->
        <add name="DBConn" 
             connectionString="Data Source=.;Initial Catalog=BikeStores;Persist Security Info=True;User ID=sa;Password=mcc#1234" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
