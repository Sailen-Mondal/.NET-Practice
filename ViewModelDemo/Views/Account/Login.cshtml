@model ViewModelDemo.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Login";
}

<div class="container-narrow">
    <div class="card">
        <h1 class="card-header" style="font-size: 20px; text-align: center; margin-bottom: 20px;">Sign in to your account</h1>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReturnUrl)

            if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" style="margin-bottom: 16px;">
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <div class="form-group">
                <label class="form-label" for="UsernameOrEmail">Username or Email</label>
                @Html.TextBoxFor(m => m.UsernameOrEmail, new { @class = "form-control", placeholder = "e.g. admin or rahul" })
                @Html.ValidationMessageFor(m => m.UsernameOrEmail, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label class="form-label" for="Password">Password</label>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-group" style="display: flex; align-items: center; justify-content: space-between;">
                <label style="font-size: 13px; color: #4b5563; display: flex; align-items: center; gap: 6px; cursor: pointer;">
                    @Html.CheckBoxFor(m => m.RememberMe)
                    Remember me
                </label>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 8px;">Sign In</button>
        }

        <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-light); font-size: 13px; color: var(--text-muted); text-align: center;">
            Don't have an account? <a href="/Account/Register" style="color: var(--primary); text-decoration: none; font-weight: 500;">Register here</a>
        </div>
    </div>

    <!-- Demo Credentials Box -->
    <div class="card" style="background-color: #f9fafb; border-style: dashed;">
        <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 8px;">
            Pre-Configured Test Accounts
        </div>
        <div style="font-size: 13px; display: grid; row-gap: 6px;">
            <div>
                <strong>Administrator</strong> (Full CRUD + Dashboard):<br />
                <code style="background: #e5e7eb; padding: 2px 5px; border-radius: 3px;">admin</code> / <code style="background: #e5e7eb; padding: 2px 5px; border-radius: 3px;">Admin@123</code>
            </div>
            <div style="margin-top: 4px;">
                <strong>Standard User</strong> (Read-only Directory):<br />
                <code style="background: #e5e7eb; padding: 2px 5px; border-radius: 3px;">rahul</code> / <code style="background: #e5e7eb; padding: 2px 5px; border-radius: 3px;">User@123</code>
            </div>
        </div>
    </div>
</div>
