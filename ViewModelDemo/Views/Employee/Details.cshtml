@model ViewModelDemo.ViewModels.EmployeeDetailsViewModel
@{
    ViewBag.Title = Model.PageTitle;
    var currentUser = Session["CurrentUser"] as ViewModelDemo.Models.UserSession;
    bool isAdmin = currentUser != null && currentUser.IsAdmin;
}

<div class="container" style="max-width: 760px;">
    <div class="page-header">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <span class="tag" style="font-size: 11px;">Model Aggregation</span>
                <span class="tag" style="font-size: 11px;">ID: @Model.Employee.EmployeeId</span>
            </div>
            <h1 class="page-title">@Model.PageHeader</h1>
            <p class="page-subtitle">Demonstrating Multiple Model Aggregation into a single ViewModel</p>
        </div>
        <div style="display: flex; gap: 8px;">
            @if (isAdmin)
            {
                <a href="/Employee/Edit/@Model.Employee.EmployeeId" class="btn btn-secondary">Edit Employee</a>
            }
            <a href="/Employee/Index" class="btn btn-secondary">&larr; Directory</a>
        </div>
    </div>

    <!-- Employee Basic Information Card -->
    <div class="card" style="margin-bottom: 20px;">
        <h2 class="card-header">Employee Basic Information</h2>
        <div style="display: grid; grid-template-columns: 140px 1fr; row-gap: 14px; font-size: 14px; align-items: center;">
            <div style="color: var(--text-muted); font-weight: 500;">Employee ID</div>
            <div style="color: var(--text-dark); font-family: var(--font-mono);">@Model.Employee.EmployeeId</div>

            <div style="color: var(--text-muted); font-weight: 500;">Name</div>
            <div style="color: var(--text-dark); font-size: 15px;"><strong>@Model.Employee.Name</strong></div>

            <div style="color: var(--text-muted); font-weight: 500;">Gender</div>
            <div style="color: var(--text-dark);">@Model.Employee.Gender</div>

            <div style="color: var(--text-muted); font-weight: 500;">Department</div>
            <div style="color: var(--text-dark);"><span class="tag">@Model.Employee.Department</span></div>

            <div style="color: var(--text-muted); font-weight: 500;">Salary</div>
            <div style="color: var(--text-dark); font-weight: 600;">Rs. @Model.Employee.Salary.ToString("N2")</div>
        </div>
    </div>

    <!-- Employee Address Information Card -->
    <div class="card">
        <h2 class="card-header">Employee Address Information</h2>
        <div style="display: grid; grid-template-columns: 140px 1fr; row-gap: 14px; font-size: 14px; align-items: center;">
            <div style="color: var(--text-muted); font-weight: 500;">Address ID</div>
            <div style="color: var(--text-dark); font-family: var(--font-mono);">@Model.Address.AddressId</div>

            <div style="color: var(--text-muted); font-weight: 500;">City</div>
            <div style="color: var(--text-dark); font-weight: 500;">@Model.Address.City</div>

            <div style="color: var(--text-muted); font-weight: 500;">State</div>
            <div style="color: var(--text-dark);">@Model.Address.State</div>

            <div style="color: var(--text-muted); font-weight: 500;">Country</div>
            <div style="color: var(--text-dark);">@Model.Address.Country</div>

            <div style="color: var(--text-muted); font-weight: 500;">PIN Code</div>
            <div style="color: var(--text-dark); font-family: var(--font-mono);">@Model.Address.Pin</div>
        </div>
    </div>
</div>
