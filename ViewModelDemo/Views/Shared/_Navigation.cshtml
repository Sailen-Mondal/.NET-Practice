@{
    var currentUser = Session["CurrentUser"] as ViewModelDemo.Models.UserSession;
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<header class="top-nav">
    <div class="nav-container">
        <div class="nav-left">
            <a class="nav-brand" href="/Employee/Index" title="ViewModel Architecture Demo">
                <svg class="nav-brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
                <span>ViewModel Demo</span>
            </a>
            <nav class="nav-menu" aria-label="Primary navigation">
                <a class="nav-link @(currentController == "Employee" && currentAction == "Index" ? "active" : "")" href="/Employee/Index">Employees</a>
                <a class="nav-link @(currentController == "Employee" && currentAction == "Details" ? "active" : "")" href="/Employee/Details">Details</a>
                <a class="nav-link @(currentController == "Student" && currentAction == "getStud" ? "active" : "")" href="/Student/getStud">Student Marks</a>
                @if (currentUser != null && currentUser.IsAdmin)
                {
                    <a class="nav-link @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")" href="/Admin/Dashboard">Admin Dashboard</a>
                    <a class="nav-link @(currentController == "Admin" && currentAction == "Users" ? "active" : "")" href="/Admin/Users">Users</a>
                }
            </nav>
        </div>
        <div class="nav-right">
            @if (currentUser != null)
            {
                <div class="user-pill" title="Signed in as @currentUser.Username">
                    <span class="user-avatar">@(string.IsNullOrEmpty(currentUser.FullName) ? "U" : currentUser.FullName.Substring(0, 1))</span>
                    <span class="user-name">@currentUser.FullName</span>
                    <span class="role-badge @(currentUser.IsAdmin ? "badge-admin" : "badge-user")">@currentUser.Role</span>
                </div>
                <a href="/Account/Logout" class="btn btn-secondary btn-sm">Logout</a>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-secondary btn-sm">Login</a>
                <a href="/Account/Register" class="btn btn-primary btn-sm">Register</a>
            }
            <button type="button" id="mobileNavToggle" class="nav-mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobileNavDrawer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobileNavOverlay" class="nav-drawer-overlay"></div>
<aside id="mobileNavDrawer" class="nav-drawer" aria-label="Mobile navigation">
    <div class="nav-drawer-header">
        <a class="nav-brand" href="/Employee/Index">
            <svg class="nav-brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
            <span>ViewModel Demo</span>
        </a>
        <button type="button" id="mobileNavClose" class="nav-drawer-close" aria-label="Close navigation menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>
    <nav class="nav-drawer-links">
        <a class="@(currentController == "Employee" && currentAction == "Index" ? "active" : "")" href="/Employee/Index">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            <span>Employees</span>
        </a>
        <a class="@(currentController == "Employee" && currentAction == "Details" ? "active" : "")" href="/Employee/Details">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            <span>Details</span>
        </a>
        <a class="@(currentController == "Student" && currentAction == "getStud" ? "active" : "")" href="/Student/getStud">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
            <span>Student Marks</span>
        </a>
        @if (currentUser != null && currentUser.IsAdmin)
        {
            <a class="@(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")" href="/Admin/Dashboard">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                <span>Admin Dashboard</span>
            </a>
            <a class="@(currentController == "Admin" && currentAction == "Users" ? "active" : "")" href="/Admin/Users">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span>Users</span>
            </a>
        }
    </nav>
    <div class="nav-drawer-footer">
        @if (currentUser != null)
        {
            <div class="user-pill" style="width: 100%; justify-content: flex-start;">
                <span class="user-avatar">@(string.IsNullOrEmpty(currentUser.FullName) ? "U" : currentUser.FullName.Substring(0, 1))</span>
                <span class="user-name">@currentUser.FullName</span>
                <span class="role-badge @(currentUser.IsAdmin ? "badge-admin" : "badge-user")">@currentUser.Role</span>
            </div>
            <a href="/Account/Logout" class="btn btn-secondary" style="width: 100%;">Logout</a>
        }
        else
        {
            <a href="/Account/Login" class="btn btn-secondary" style="width: 100%;">Login</a>
            <a href="/Account/Register" class="btn btn-primary" style="width: 100%;">Register</a>
        }
    </div>
</aside>
