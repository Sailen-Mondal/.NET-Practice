<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WebServices.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - WebServices</title>

    <style>
        /* Fonts */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        /* Reset */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        /* Notion Palette Tokens */
        :root {
            --bg:           #ffffff;
            --bg-secondary: #f7f6f3;
            --bg-hover:     #efefed;
            --border:       #e9e9e7;
            --border-dark:  #d3d2cf;
            --text:         #37352f;
            --text-muted:   #9b9a97;
            --text-light:   #6b6b6b;
            --accent:       #2383e2;
            --sidebar-w:    240px;
            --topbar-h:     45px;
            --radius:       4px;
            --font:         'Inter', ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        html, body {
            height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: var(--font);
            font-size: 15px;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        /* Top Bar */
        .topbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            height: var(--topbar-h);
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 16px;
            z-index: 100;
            gap: 12px;
        }
        .topbar-brand {
            font-size: 14px;
            font-weight: 600;
            color: var(--text);
            letter-spacing: -0.02em;
            text-decoration: none;
        }
        .topbar-sep {
            color: var(--border-dark);
            font-size: 16px;
            font-weight: 300;
        }
        .topbar-page {
            font-size: 14px;
            color: var(--text-muted);
            font-weight: 400;
        }
        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 12px;
            color: var(--text-muted);
        }
        .status-dot {
            width: 7px;
            height: 7px;
            background: #2eaadc;
            border-radius: 50%;
            display: inline-block;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: var(--topbar-h);
            left: 0;
            width: var(--sidebar-w);
            height: calc(100% - var(--topbar-h));
            background: var(--bg-secondary);
            border-right: 1px solid var(--border);
            padding: 12px 8px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .sidebar-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 8px 10px 4px;
        }
        .sidebar a {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 7px 10px;
            border-radius: var(--radius);
            text-decoration: none;
            color: var(--text);
            font-size: 14px;
            font-weight: 400;
            transition: background 0.12s;
        }
        .sidebar a:hover { background: var(--bg-hover); }
        .sidebar a.active {
            background: var(--bg-hover);
            font-weight: 500;
        }
        .nav-icon {
            width: 17px;
            height: 17px;
            opacity: 0.6;
            flex-shrink: 0;
        }
        .sidebar-footer {
            margin-top: auto;
            padding: 12px 10px 8px;
            font-size: 11px;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
            line-height: 1.4;
        }

        /* Main Content Container */
        .main {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            min-height: calc(100vh - var(--topbar-h));
            padding: 48px 80px 80px;
            max-width: 1040px;
        }

        /* Typography & Components */
        .page-title {
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: var(--text);
            margin-bottom: 6px;
            line-height: 1.2;
        }
        .page-subtitle {
            font-size: 15px;
            color: var(--text-muted);
            margin-bottom: 28px;
        }
        .notion-divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 28px 0;
        }
        .notion-h3 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 12px;
            margin-top: 24px;
        }
        .notion-p {
            font-size: 14px;
            color: var(--text-light);
            line-height: 1.7;
            margin-bottom: 12px;
        }
        .notion-callout {
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 14px 18px;
            font-size: 14px;
            color: var(--text-light);
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 24px;
            line-height: 1.6;
        }
        .callout-icon {
            width: 17px;
            height: 17px;
            opacity: 0.55;
            flex-shrink: 0;
            margin-top: 3px;
        }

        /* Notion Cards Grid */
        .notion-card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 16px;
            margin: 20px 0;
        }
        .notion-card {
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px;
            background: var(--bg);
            transition: border-color 0.15s, box-shadow 0.15s;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
        }
        .notion-card:hover {
            border-color: var(--border-dark);
            background: var(--bg-secondary);
        }
        .notion-card-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .notion-card-desc {
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 12px;
            flex-grow: 1;
        }
        .notion-card-badge {
            align-self: flex-start;
            font-size: 11px;
            padding: 2px 7px;
            border-radius: 3px;
            background: var(--bg-hover);
            color: var(--text-light);
            border: 1px solid var(--border);
            font-family: 'SFMono-Regular', Consolas, monospace;
        }

        /* Forms & Inputs */
        .notion-form-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }
        .notion-form-label {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-light);
            min-width: 130px;
        }
        .notion-input {
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 7px 12px;
            font-size: 14px;
            font-family: var(--font);
            color: var(--text);
            background: var(--bg);
            outline: none;
            transition: border-color 0.15s;
            min-width: 240px;
        }
        .notion-input:focus {
            border-color: var(--border-dark);
        }
        .notion-input[readonly] {
            background: var(--bg-secondary);
            color: var(--text-light);
        }
        .notion-btn {
            background: var(--text);
            color: #ffffff;
            border: 1px solid var(--text);
            border-radius: var(--radius);
            padding: 7px 16px;
            font-size: 13px;
            font-family: var(--font);
            font-weight: 500;
            cursor: pointer;
            transition: opacity 0.15s;
        }
        .notion-btn:hover {
            opacity: 0.9;
        }
        .notion-btn-secondary {
            background: var(--bg-secondary);
            color: var(--text);
            border: 1px solid var(--border);
        }
        .notion-btn-secondary:hover {
            background: var(--bg-hover);
        }

        /* GridView & Tables */
        .gv-wrap {
            margin-top: 16px;
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }
        .gv-wrap table, table.notion-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }
        .gv-wrap th, table.notion-table th {
            text-align: left;
            padding: 9px 14px;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border);
            font-weight: 500;
            color: var(--text-muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            white-space: nowrap;
        }
        .gv-wrap td, table.notion-table td {
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
            color: var(--text);
            vertical-align: top;
            font-size: 14px;
        }
        .gv-wrap tr:last-child td, table.notion-table tr:last-child td {
            border-bottom: none;
        }
        .gv-wrap tbody tr:hover td, table.notion-table tbody tr:hover td {
            background: var(--bg-secondary);
        }
        .gv-empty td {
            padding: 36px 0;
            text-align: center;
            color: var(--text-muted);
            font-size: 14px;
            border-bottom: none !important;
            background: none !important;
        }
        .gv-count {
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 8px;
            display: block;
        }

        /* Inline Code & Badges */
        code {
            font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
            font-size: 85%;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 3px;
            padding: 2px 5px;
            color: var(--text);
        }
        .notion-badge {
            display: inline-block;
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 3px;
            font-size: 12px;
            padding: 2px 8px;
            color: var(--text-light);
            font-weight: 400;
        }
        .badge-success {
            background: #edf7ed;
            border-color: #c8e6c9;
            color: #2e7d32;
        }
        .badge-info {
            background: #e8f4fd;
            border-color: #b8e2fb;
            color: #0277bd;
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
            </Scripts>
        </asp:ScriptManager>

        <!-- Top Bar -->
        <header class="topbar">
            <a class="topbar-brand" runat="server" href="~/">WebServices</a>
            <span class="topbar-sep">/</span>
            <span class="topbar-page"><%: Page.Title %></span>
            <div class="topbar-right">
                <span class="status-dot"></span>
                <span>ASMX &middot; SOAP &middot; AJAX</span>
            </div>
        </header>

        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <span class="sidebar-label">Pages</span>
            
            <a runat="server" id="navHome" href="~/">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span>Home</span>
            </a>

            <a runat="server" id="navUser" href="~/UserDirectory.aspx">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                <span>User Directory</span>
            </a>

            <a runat="server" id="navStudent" href="~/StudentPortal.aspx">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
                <span>Student Portal</span>
            </a>

            <a runat="server" id="navEndpoints" href="~/Endpoints.aspx">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
                <span>Endpoints & WSDL</span>
            </a>

            <a runat="server" id="navConcepts" href="~/Concepts.aspx">
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
                <span>Concepts & Guide</span>
            </a>

            <div class="sidebar-footer">
                <div>ASP.NET Web Services</div>
                <div>MCC IT Practice &middot; 2026</div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>
    </form>
</body>
</html>
